# Copy to .env and adjust. Never commit .env with real secrets.
#
# Names below are the ones read by config/settings.py (plus CORS_ORIGINS in api/main.py).
# Entries marked [unused] are defined in settings.py but no code reads them yet.
#
# Application
APP_NAME=Portfolio Management Terminal   # [unused]
APP_VERSION=1.0.0                        # [unused]
DEBUG=false
# development | production. production refuses to boot with the default JWT_SECRET.
# production also refuses AUTH_DISABLED=true, JWT_SECRET shorter than 32 chars, and hides /docs /redoc /openapi.json.
ENVIRONMENT=development

# Security
# IP-based rate limiting on auth + public endpoints (set false for tests).
RATE_LIMIT_ENABLED=true
# Number of trusted reverse proxies in front of the API; 0 = ignore X-Forwarded-For
# (rate limit keys on the socket peer IP). HF Spaces behind its proxy: 1.
TRUSTED_PROXY_COUNT=0

# Auth (Phase 2) — AUTH_DISABLED=true skips login for local development only (refused when ENVIRONMENT=production)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_DISABLED=false

# Database (SQLAlchemy URL)
# Docker Compose (postgres service): use host "postgres" inside containers, "localhost" on host
DATABASE_URL=postgresql+psycopg2://portfolio:portfolio@localhost:5432/portfolio
# Local SQLite file (no Postgres). The API does not boot on SQLite at present, see README "SQLite".
# DATABASE_URL=sqlite:///./data/wmc.db
DATABASE_ECHO=false

# Optional API keys (leave empty if unused) [unused: no provider client reads them yet]
ALPHA_VANTAGE_API_KEY=
IEX_CLOUD_API_KEY=

# Yahoo Finance [unused]
YAHOO_FINANCE_ENABLED=true

# Cache: PRICE_CACHE_DIR is read; CACHE_ENABLED and CACHE_TTL_SECONDS are [unused]
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
PRICE_CACHE_DIR=data/cache/prices

# Performance [unused]
MAX_WORKERS=4
CALCULATION_TIMEOUT_SECONDS=30

# Risk-free rate (annual, decimal) [unused by the API; the UI sends its own value]
RISK_FREE_RATE=0.0435

# Portfolio constraints [unused]
MAX_PORTFOLIO_POSITIONS=100
MIN_POSITION_WEIGHT=0.0
MAX_POSITION_WEIGHT=1.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Stripe billing (Phase 5)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
FRONTEND_URL=http://localhost:3000
BILLING_ENFORCEMENT=true

# CORS: extra allowed origins for the API, comma-separated (FRONTEND_URL and localhost:3000 are always allowed)
# CORS_ORIGINS=https://app.example.com

# Hugging Face Spaces image only (root Dockerfile): listen port, default 7860
# PORT=7860

# Next.js frontend (set in frontend/.env.local or compose, not read by the API)
# NEXT_PUBLIC_API_URL=http://localhost:8000 # frontend/.env.example; browser-side base (build-time)
# API_INTERNAL_URL=http://localhost:8000   # server-side API base URL used by the BFF proxy
# COOKIE_SECURE=true                        # set true behind HTTPS
