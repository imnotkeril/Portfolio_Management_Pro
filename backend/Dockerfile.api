FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# requirements.lock.txt pins every (transitive) version -> reproducible builds.
COPY requirements.txt requirements.lock.txt /app/
RUN pip install --no-cache-dir -c /app/requirements.lock.txt -r /app/requirements.txt

# Run as an unprivileged user (UID 1000, matches typical Linux hosts so the
# ./data bind mount in docker-compose stays writable).
RUN useradd -m -u 1000 app

COPY --chown=app:app . /app
RUN mkdir -p /app/data/cache/prices /app/logs && chown -R app:app /app/data /app/logs

USER app

EXPOSE 8000

# Use /bin/sh -c (not a .sh ENTRYPOINT) to avoid Windows CRLF breaking the shebang in Docker
ENTRYPOINT ["/bin/sh", "-c", "alembic upgrade head && exec uvicorn api.main:app --host 0.0.0.0 --port 8000"]

